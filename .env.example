# Public configuration for the Orbit frontend. These values are not secrets.
# Production (Vercel) uses Arc mainnet. The vault factory address matches an older
# testnet contract's text; on chain 5042 the bytecode is factory version 2.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_FACTORY_ADDRESS=0xA9Cdb36A8c1E20755AE294eff6978525A1f01a1d
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=26000245
NEXT_PUBLIC_WORKSPACE_FACTORY_ADDRESS=0x8fb1a3cff48ec873ef0526a902425813979c7b9e
NEXT_PUBLIC_WORKSPACE_DEPLOY_BLOCK=26000255

# Arc Testnet, if you are developing against chain 5042002 instead:
# NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# NEXT_PUBLIC_FACTORY_ADDRESS=0x50ab19e57dff6f2de6e8f3a17ef96417f39cb793
# NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=67213321
# NEXT_PUBLIC_WORKSPACE_FACTORY_ADDRESS=0x8F5C16679FB2b50344fBb5b599A37783613a34CD
# NEXT_PUBLIC_WORKSPACE_DEPLOY_BLOCK=67226927

# Optional. Injected wallets work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Privy app id from https://dashboard.privy.io. Enables the single wallet modal.
# Allow http://localhost:3000 as an allowed origin in that app. Leave empty to use the injected wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Pay-per-API and the intent relay. The relayer key is a third account: not the owner and not the agent.
# Do not point these at the version 1 Arc Testnet factory. Its clones cannot execute payment intents.
# PAY_API_PORT=8787
# PAY_RPC_URL=https://rpc.testnet.arc.io
# PAY_CHAIN_ID=5042002
# PAY_PROVIDER_RECIPIENT=
# PAY_RELAYER_PRIVATE_KEY=
# PAY_FACTORY_ADDRESS=
# PAY_START_BLOCK=
# NEXT_PUBLIC_PAY_API_URL=http://127.0.0.1:8787

# NEXT_PUBLIC_GUARDIAN_URL=http://127.0.0.1:8788
# GUARDIAN_WORKSPACES=
# GUARDIAN_FROM_BLOCK=
# GUARDIAN_RPC_URL=https://rpc.testnet.arc.io
# PAYWALL_VAULT=
# PAYWALL_RECIPIENT=

# Mainnet payments refuse known testnet factories. A mainnet relayer also requires PAY_RELAY_MAX_NATIVE
# (native USDC wei cap for sponsorship). Leave it unset until that cap is chosen.
# PAY_CHAIN_ID=5042
# PAY_RPC_URL=https://rpc.mainnet.arc.io
# PAY_RELAY_MAX_NATIVE=

# Untracked local keys only. Never commit real values.
# PRIVATE_KEY=
# AGENT_PRIVATE_KEY=
# ARC_RPC_URL=https://rpc.testnet.arc.io
